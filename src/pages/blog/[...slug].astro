---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import FinalCta from '../../components/marketing/FinalCta.astro';
import { BRAND } from '../../config/brand';
import { blogAlternates, blogSwitcher } from '../../config/i18n';
import { getContent } from '../../i18n/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
// FAQ-bearing posts (ARY-470): map frontmatter Q&As to FaqItem so Base/Seo emit
// FAQPage JSON-LD alongside BlogPosting. Undefined when no `faqs` declared.
const faq = post.data.faqs?.map((f) => ({ q: f.question, a: f.answer }));
// Advertise the localized variants (ARY-523): hreflang alternates + the language
// switcher point at each locale's translated-slug URL. `post.id` is the English
// canonical id (the manifest key).
const alternates = blogAlternates(post.id, BRAND.url);
const switcher = blogSwitcher(post.id, 'en');
// BreadcrumbList (ARY-2288): Home › Guides › <post> so spoke articles are
// eligible for the breadcrumb rich result and give AI answer engines the page's
// place in the site hierarchy. Labels come from the localized blog-chrome overlay.
const chrome = getContent<{ crumbs: { home: string; guides: string } }>('blog-chrome', 'en');
const breadcrumbs = [
  { name: chrome.crumbs.home, url: `${BRAND.url}/` },
  { name: chrome.crumbs.guides, url: `${BRAND.url}/blog/` },
  { name: post.data.title, url: new URL(`/blog/${post.id}/`, BRAND.url).href },
];
---
<Base
  title={post.data.title}
  path={`/blog/${post.id}/`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  faq={faq}
  breadcrumbs={breadcrumbs}
  alternates={alternates}
  switcher={switcher}
>
  <article class="section">
    <div class="container prose">
      <p class="updated"><a href="/blog/">← All guides</a></p>
      <h1>{post.data.title}</h1>
      <p class="updated">{fmt(post.data.pubDate)}</p>
      {post.data.placeholder && (
        <div class="note"><strong>Template article</strong> — outline only, pending CMO cornerstone copy (C2).</div>
      )}
      <Content />
    </div>
  </article>

  <FinalCta
    title="Ready to start your own?"
    body="Vaulto turns this into action. Start free — no spreadsheets required."
    ctaId="blog_post_final"
  />
</Base>
